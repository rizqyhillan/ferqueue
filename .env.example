# Backend
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql://ferqueue:change-me-local@localhost:5432/ferqueue
# Buat database/user tersebut melalui instalasi PostgreSQL lokal/pgAdmin.

# Computer vision
CV_API_URL=http://localhost:8000
CV_SOURCE=0
# Threshold/NMS kamera dibaca dari config JSON yang dipilih saat API dijalankan.
# Config tidak dimuat otomatis dari .env; set CV_CONFIG_PATH di environment jika diperlukan.
CV_CONFIG_PATH=apps/computer-vision/configs/coco.json

# ESP32 (untuk konfigurasi lokal, bukan untuk di-commit)
WIFI_SSID=your-wifi-name
WIFI_PASSWORD=your-wifi-password
BACKEND_BASE_URL=http://192.168.1.10:8000
