# Backend & Web Monitoring
SECRET_KEY=ferqueue-dev-2026
WEB_HOST=0.0.0.0
WEB_PORT=5000
API_HOST=0.0.0.0
API_PORT=8000

# MySQL Database (Laragon / phpMyAdmin — skema ada di apps/web-monitoring/database/ferqueue_db.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gate_pelabuhan

# LLM & RAG (Gemini + ChromaDB)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CHROMA_PATH=../../data/vector_db
RAG_MAX_DISTANCE=0.50

# Computer vision
CV_API_URL=http://127.0.0.1:8000
CV_SOURCE=0
# Threshold/NMS kamera dibaca dari config JSON yang dipilih saat API dijalankan.
# Config tidak dimuat otomatis dari .env; set CV_CONFIG_PATH di environment jika diperlukan.
CV_CONFIG_PATH=apps/computer-vision/configs/receiver-v4.json

# ESP32 (untuk konfigurasi lokal, bukan untuk di-commit)
WIFI_SSID=your-wifi-name
WIFI_PASSWORD=your-wifi-password
BACKEND_BASE_URL=http://192.168.1.12:5000
